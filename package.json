{
  "name": "v4",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint",
    "typecheck": "tsc --noEmit",
    "migrate": "pnpm payload migrate:create",
    "seed": "tsx -r dotenv/config src/scripts/seed/seed.ts",
    "seed:perf": "tsx -r dotenv/config src/scripts/seed/perf.seed.ts",
    "auto-links": "tsx -r dotenv/config src/scripts/auto-links.ts",
    "discover-links": "tsx -r dotenv/config src/jobs/discoverLinks.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:e2e:layout": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test tests/playwright/e2e/layout.e2e.spec.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:int:seed": "cross-env SEED_VERIFY=1 NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/vitest/int/seed-scenarios.int.spec.ts",
    "test:int:migrations": "cross-env RUN_MIGRATION_DB_TESTS=true NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/vitest/int/migrations.int.spec.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^7.0.1",
    "@lexical/code": "0.53.0",
    "@lexical/link": "0.53.0",
    "@lexical/list": "0.53.0",
    "@lexical/markdown": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/table": "0.53.0",
    "@payloadcms/db-postgres": "4.0.0-beta.7",
    "@payloadcms/next": "4.0.0-beta.7",
    "@payloadcms/richtext-lexical": "4.0.0-beta.7",
    "@payloadcms/transformer-sharp": "4.0.0-beta.7",
    "@payloadcms/ui": "4.0.0-beta.7",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "18.0.9",
    "fast-xml-parser": "^5.11.2",
    "graphql": "^17.0.2",
    "lexical": "0.53.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "openai": "^7.47.0",
    "payload": "4.0.0-beta.7",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fallow": "^3.38.1",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22 || ^24",
    "pnpm": "^10 || ^11"
  }
}
