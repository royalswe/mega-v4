{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["dotenv"],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": ["src/migrations/**", "src/payload-types.ts"]
  },
  "rules": {
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "test-only-dependencies": "warn",
    "boundary-violation": "off",
    "policy-violation": "off"
  },
  "ignoreExports": [
    {
      "file": "src/migrations/**",
      "exports": ["*"]
    },
    {
      "file": "src/payload-types.ts",
      "exports": ["SupportedTimezones", "Auth", "GeneratedTypes"]
    }
  ],
  "ignoreUnresolvedImports": ["tailwindcss"]
}
